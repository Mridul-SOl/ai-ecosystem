# ==========================================
# AI ECOSYSTEM CONFIGURATION
# ==========================================

# Application
APP_NAME="AI ECOSYSTEM"
APP_ENV=production
DEBUG=false
SECRET_KEY=replace-with-a-very-secure-random-secret-key-32-chars-min
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database
DATABASE_URL=sqlite+aiosqlite:///./data/ai_ecosystem.db
SQLITE_SYNC_URL=sqlite:///./data/ai_ecosystem.db

# Vector Memory (ChromaDB)
CHROMA_PERSIST_DIR=./data/chroma

# AI Providers
DEFAULT_LLM_PROVIDER=groq  # options: groq, openai, ollama, heuristic
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3

# Supabase Authentication
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your_supabase_anon_publishable_key
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_KEY=your_supabase_anon_publishable_key

# Integrations
GITHUB_TOKEN=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_USE_TLS=true

# Security Approval Gating
REQUIRE_APPROVAL_FOR_EMAIL=true
REQUIRE_APPROVAL_FOR_GITHUB=true
REQUIRE_APPROVAL_FOR_SCRAPING=false

# CORS
ALLOWED_ORIGINS=["*"]
