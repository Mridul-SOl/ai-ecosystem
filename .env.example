# ==========================================
# AI ECOSYSTEM CONFIGURATION
# ==========================================

# Application
APP_NAME="AI ECOSYSTEM"
APP_ENV=production
DEBUG=false
SECRET_KEY=replace-with-a-very-secure-random-secret-key-32-chars-min
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database
DATABASE_URL=sqlite+aiosqlite:///./data/ai_ecosystem.db
SQLITE_SYNC_URL=sqlite:///./data/ai_ecosystem.db

# Vector Memory (ChromaDB)
CHROMA_PERSIST_DIR=./data/chroma

# AI Providers
DEFAULT_LLM_PROVIDER=openai  # options: openai, ollama, heuristic
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3

# Integrations
GITHUB_TOKEN=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_USE_TLS=true

# Security Approval Gating
REQUIRE_APPROVAL_FOR_EMAIL=true
REQUIRE_APPROVAL_FOR_GITHUB=true
REQUIRE_APPROVAL_FOR_SCRAPING=false

# CORS
ALLOWED_ORIGINS=["*"]
